{
  "name": "womm",
  "version": "0.1.0",
  "description": "A courtroom for \"works on my machine\" bugs: compare two setups and put the likely cause on trial.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "works-on-my-machine",
    "environment",
    "diff",
    "debugging",
    "cli",
    "developer-tools"
  ],
  "bin": {
    "womm": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "semver": "^7.8.6",
    "yaml": "^2.9.1"
  }
}
